{
  "name": "@ssoo/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "db:generate": "prisma generate --generator client",
    "db:push": "node scripts/guarded-db-push.mjs",
    "db:push:unsafe-local": "node scripts/guarded-db-push.mjs",
    "db:migrate": "prisma migrate dev --config prisma.launch.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.launch.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.launch.config.ts",
    "db:baseline:verify": "node scripts/verify-launch-baseline.mjs",
    "db:baseline:resolve": "node scripts/resolve-launch-baseline.mjs",
    "db:runtime:verify": "node scripts/verify-runtime-database.mjs",
    "db:common-codes:verify": "node scripts/verify-common-code-migration.mjs",
    "db:crm-business-years:verify": "node scripts/verify-crm-business-year-migration.mjs",
    "db:onboarding:verify": "node scripts/verify-onboarding.mjs",
    "db:contract:test": "node scripts/launch-database-contract.test.mjs",
    "db:studio": "prisma studio",
    "docs:db:dbml": "prisma generate --schema prisma/schema.prisma",
    "docs:db:split": "node scripts/split-dbml.js",
    "docs:db:export": "node scripts/export-dbml.js",
    "docs:db:render": "node scripts/render-dbml.js",
    "docs:db": "pnpm run docs:db:dbml && pnpm run docs:db:split && pnpm run docs:db:export && pnpm run docs:db:render"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@dbml/cli": "^5.4.1",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "pg": "^8.17.1",
    "prisma": "^6.2.0",
    "prisma-dbml-generator": "^0.12.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
